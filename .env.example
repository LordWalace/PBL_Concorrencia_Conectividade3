# Exemplo de .env pronto para copiar e colar.
# O cliente roda em uma maquina separada e usa seu proprio bloco.
# Cada bloco de setor abaixo inclui todas as variaveis globais e locais.

# --- BLOCO CLIENTE ---
# Use este bloco somente na maquina do cliente, separado dos gateways.
# O cliente precisa apenas das portas e dos IPs dos gateways.
# Portas usadas para conexao do cliente com os gateways
GATEWAY_TCP_CLIENT_PORT=10081
GATEWAY_TCP_REG_PORT=10080
GATEWAY_TCP_PEER_PORT=10082

# Enderecos de cada gateway na rede
IP_NORTE=172.16.103.1
IP_SUL=172.16.103.2
IP_LESTE=172.16.103.3
IP_OESTE=172.16.103.4

# --- BLOCO ADMIN ---
# Use este bloco somente na maquina do administrador, separado dos gateways.
# O painel de admin precisa apenas das portas e dos IPs dos gateways.
# Portas usadas para conexao do admin com os gateways
GATEWAY_TCP_CLIENT_PORT=10081
GATEWAY_TCP_REG_PORT=10080
GATEWAY_TCP_PEER_PORT=10082

# Enderecos de cada gateway na rede
IP_NORTE=172.16.103.1
IP_SUL=172.16.103.2
IP_LESTE=172.16.103.3
IP_OESTE=172.16.103.4

# Enderecos de cada gateway na rede
IP_NORTE=172.16.103.1
IP_SUL=172.16.103.2
IP_LESTE=172.16.103.3
IP_OESTE=172.16.103.4

# --- BLOCO NORTE ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.1
IP_SUL=172.16.103.2
IP_LESTE=172.16.103.3
IP_OESTE=172.16.103.4

# Portas usadas pelo gateway Norte
GATEWAY_TCP_CLIENT_PORT=10081
GATEWAY_TCP_REG_PORT=10080
GATEWAY_TCP_PEER_PORT=10082

# Esses sao os tempos do drone e do beacon
MISSION_DURATION=10s
BEACON_MIN_INTERVAL=10
BEACON_MAX_INTERVAL=30

# Configuracao do gateway do setor Norte
GATEWAY_ID=Norte
GATEWAY_IP=172.16.103.1
GATEWAY_HOST=0.0.0.0
SETOR_ID=Norte

# Configuracao do device/drone do setor Norte
DEVICE_ID=Drone_Norte
DEVICE_IP=172.16.103.1
DEVICE_HOST=0.0.0.0
DEVICE_CONTROL_PORT=10083


# --- BLOCO SUL ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.1
IP_SUL=172.16.103.2
IP_LESTE=172.16.103.3
IP_OESTE=172.16.103.4

# Portas usadas pelo gateway Sul
GATEWAY_TCP_CLIENT_PORT=10081
GATEWAY_TCP_REG_PORT=10080
GATEWAY_TCP_PEER_PORT=10082

# Esses sao os tempos do drone e do beacon
MISSION_DURATION=10s
BEACON_MIN_INTERVAL=10
BEACON_MAX_INTERVAL=30

# Configuracao do gateway do setor Sul
GATEWAY_ID=Sul
GATEWAY_IP=172.16.103.2
GATEWAY_HOST=0.0.0.0
SETOR_ID=Sul

# Configuracao do device/drone do setor Sul
DEVICE_ID=Drone_Sul
DEVICE_IP=172.16.103.2
DEVICE_HOST=0.0.0.0
DEVICE_CONTROL_PORT=10083


