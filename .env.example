# Exemplo de .env pronto para copiar e colar.
# O cliente roda em uma maquina separada e usa seu proprio bloco.
# Cada bloco de setor abaixo inclui todas as variaveis globais e locais.

# --- BLOCO CLIENTE ---
# Use este bloco somente na maquina do cliente, separado dos gateways.
# O cliente precisa apenas das portas e dos IPs dos gateways.
# Portas usadas para conexao do cliente com os gateways
GATEWAY_TCP_CLIENT_PORT=8081
GATEWAY_TCP_REG_PORT=8080
GATEWAY_TCP_PEER_PORT=8082

# Enderecos de cada gateway na rede
IP_NORTE=172.16.103.14
IP_SUL=172.16.103.13
IP_LESTE=172.16.103.12
IP_OESTE=172.16.103.11

# --- BLOCO NORTE ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.14
IP_SUL=172.16.103.13
IP_LESTE=172.16.103.12
IP_OESTE=172.16.103.11

# Portas usadas pelo gateway Norte
GATEWAY_TCP_CLIENT_PORT=8081
GATEWAY_TCP_REG_PORT=8080
GATEWAY_TCP_PEER_PORT=8082

# Esses sao os tempos do drone e do beacon
MISSION_DURATION=20s
BEACON_MIN_INTERVAL=10
BEACON_MAX_INTERVAL=30

# Configuracao do gateway do setor Norte
GATEWAY_ID_NORTE=Norte
GATEWAY_IP_NORTE=172.16.103.14
GATEWAY_HOST_NORTE=0.0.0.0
SETOR_ID_NORTE=Norte

# Configuracao do device/drone do setor Norte
DEVICE_ID_NORTE=Drone_Norte
DEVICE_IP_NORTE=172.16.103.14
DEVICE_HOST_NORTE=0.0.0.0
DEVICE_CONTROL_PORT_NORTE=8083


# --- BLOCO SUL ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.14
IP_SUL=172.16.103.13
IP_LESTE=172.16.103.12
IP_OESTE=172.16.103.11

# Portas usadas pelo gateway Sul
GATEWAY_TCP_CLIENT_PORT=8081
GATEWAY_TCP_REG_PORT=8080
GATEWAY_TCP_PEER_PORT=8082

# Esses sao os tempos do drone e do beacon
MISSION_DURATION=20s
BEACON_MIN_INTERVAL=10
BEACON_MAX_INTERVAL=30

# Configuracao do gateway do setor Sul
GATEWAY_ID_SUL=Sul
GATEWAY_IP_SUL=172.16.103.13
GATEWAY_HOST_SUL=0.0.0.0
SETOR_ID_SUL=Sul

# Configuracao do device/drone do setor Sul
DEVICE_ID_SUL=Drone_Sul
DEVICE_IP_SUL=172.16.103.13
DEVICE_HOST_SUL=0.0.0.0
DEVICE_CONTROL_PORT_SUL=8083


# --- BLOCO LESTE ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.14
IP_SUL=172.16.103.13
IP_LESTE=172.16.103.12
IP_OESTE=172.16.103.11

# Portas usadas pelo gateway Leste
GATEWAY_TCP_CLIENT_PORT=8081
GATEWAY_TCP_REG_PORT=8080
GATEWAY_TCP_PEER_PORT=8082

# Esses sao os tempos do drone e do beacon
MISSION_DURATION=20s
BEACON_MIN_INTERVAL=10
BEACON_MAX_INTERVAL=30

# Configuracao do gateway do setor Leste
GATEWAY_ID_LESTE=Leste
GATEWAY_IP_LESTE=172.16.103.12
GATEWAY_HOST_LESTE=0.0.0.0
SETOR_ID_LESTE=Leste

# Configuracao do device/drone do setor Leste
DEVICE_ID_LESTE=Drone_Leste
DEVICE_IP_LESTE=172.16.103.12
DEVICE_HOST_LESTE=0.0.0.0
DEVICE_CONTROL_PORT_LESTE=8083


# --- BLOCO OESTE ---
# Enderecos de rede globais e de todos os gateways
IP_NORTE=172.16.103.14
IP_SUL=172.16.103.13
IP_LESTE=172.16.103.12
IP_OESTE=172.16.103.11

# Portas usadas pelo gateway Oeste
GATEWAY_TCP_CLIENT_PORT=8081
GATEWAY_TCP_REG_PORT=8080
GATEWAY_TCP_PEER_PORT=8082

# Esses sao os tempos do drone e do beacon
